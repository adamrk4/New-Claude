# Copy this file to .env and fill in your credentials.
# NEVER commit .env — it is listed in .gitignore.

# --- LinkedIn ---
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# --- Glassdoor ---
GLASSDOOR_EMAIL=your@email.com
GLASSDOOR_PASSWORD=yourpassword

# --- Applicant personal info (used to fill application forms) ---
APPLICANT_NAME="Your Full Name"
APPLICANT_EMAIL=your@email.com
APPLICANT_PHONE_IL="050-0000000"          # Israeli format
APPLICANT_PHONE_INTL="+972-50-000-0000"  # International format
APPLICANT_LINKEDIN_URL="https://www.linkedin.com/in/yourprofile"
APPLICANT_CITY="Tel Aviv"
APPLICANT_COUNTRY="Israel"
